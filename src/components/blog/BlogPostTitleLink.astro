---
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { title, subtitle, pubDate } = post.data;
---

<article class="space-y-4">
  <div class="space-y-2">
    <h2 class="text-3xl font-bold">
      <a href={`${post.id}`} class="hover:text-primary transition-colors hover:underline">
        {title}
      </a>
    </h2>

    {subtitle && <p class="article-subtitle">{subtitle}</p>}
  </div>

  <time datetime={pubDate.toISOString()} class="text-sm text-gray-600 dark:text-gray-400">
    {
      pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC'
      })
    }
  </time>
</article>
